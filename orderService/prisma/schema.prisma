generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  product   String
  quantity  Int
  total     Float
  createdAt DateTime @default(now()) @map("created_at")

  @@map("orders")
}