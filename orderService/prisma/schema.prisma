generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    String      @map("user_id")
  item      String
  quantity  Int
  price     Float
  status    OrderStatus @default(pending)
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("orders")
}